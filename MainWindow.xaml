<Window x:Class="OpenBackup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenBackup" Width="1180" Height="820" MinWidth="960" MinHeight="680" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
<Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="OpenBackup" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Backups you can trust." FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Versioned snapshots, clear evidence, and predictable restores." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel><TextBlock Text="LOCAL ONLY  ·  NO TELEMETRY" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
<Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,28,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BACKUP PROFILE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ProfileName" Text="No profile configured" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ProfilePath" Text="Choose a source and destination to begin." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Choose source" Click="ChooseSource_Click"/><Button Content="Choose destination" Click="ChooseDestination_Click"/><Button Content="Create snapshot" Click="CreateSnapshot_Click" Background="{StaticResource Accent}" Foreground="White"/></StackPanel></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Snapshots" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Every version stays visible until you decide otherwise." Foreground="{StaticResource Muted}" Margin="0,4,0,14"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="STATUS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Ready" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LATEST" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LatestText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FILES" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FileCountText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid><Separator Background="{StaticResource Line}" Margin="0,18,0,12"/><TextBlock Text="SNAPSHOT HISTORY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><ListBox x:Name="SnapshotList" Height="220" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="SnapshotList_SelectionChanged"/></StackPanel></Border><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AUTOMATIC BACKUPS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Schedule snapshots on this computer" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="NextRunText" Text="Not scheduled" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="ScheduleEnabled" Content="Enabled" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ScheduleChanged" Unchecked="ScheduleChanged"/><ComboBox x:Name="ScheduleInterval" Width="125" SelectionChanged="ScheduleChanged"><ComboBoxItem Content="Every hour" Tag="1"/><ComboBoxItem Content="Every 6 hours" Tag="6"/><ComboBoxItem Content="Every day" Tag="24"/><ComboBoxItem Content="Every week" Tag="168"/></ComboBox></StackPanel></Grid></Border></StackPanel>
<StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Verification" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Inspect before restoring anything." Foreground="{StaticResource Muted}" Margin="0,4,0,14"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="SELECTED SNAPSHOT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SelectedText" Text="Nothing selected" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,18"/><TextBlock x:Name="VerificationText" Text="Choose a snapshot to preview its manifest." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Verify selected snapshot" Click="VerifySnapshot_Click"/><Button Content="Restore to folder" Click="RestoreSnapshot_Click"/></StackPanel></StackPanel></Border></StackPanel></Grid>
<TextBlock Grid.Row="3" Text="OpenBackup 0.4.0  ·  Verified restore  ·  Local scheduling  ·  MIT licensed" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,0"/></Grid></Window>
